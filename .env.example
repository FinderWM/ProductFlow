# ProductFlow production-style self-hosted example.
# Copy to .env and replace every placeholder before exposing the app.

# Auth (env-only; never commit real values)
ADMIN_ACCESS_KEY=replace-with-a-long-random-admin-key
SETTINGS_ACCESS_TOKEN=replace-with-a-separate-settings-token
SESSION_SECRET=replace-with-another-long-random-session-secret

# App
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=29280
WEB_PORT=29281
APP_HOST_PORT=29280
BACKEND_CORS_ORIGINS=http://localhost:29281,http://127.0.0.1:29281
SESSION_COOKIE_SECURE=false

# Persistence (env-only). PostgreSQL and Redis run as shared standalone middleware,
# configured under /Users/yunlong/project/self/env.
POSTGRES_PASSWORD=replace-with-a-random-postgres-password
POSTGRES_HOST_PORT=15432
DATABASE_URL=postgresql+psycopg://productflow:replace-with-a-random-postgres-password@host.docker.internal:15432/inspiration_flow
REDIS_HOST_PORT=16379
REDIS_URL=redis://host.docker.internal:16379/0
STORAGE_BACKEND=local
# STORAGE_ROOT and STORAGE_HOST_PATH apply only to STORAGE_BACKEND=local.
STORAGE_ROOT=/app/storage
# STORAGE_HOST_PATH=
# Object-storage releases automatically add docker-compose.object-storage.yml, remove the /app/storage mount,
# and use STORAGE_TEMP_ROOT=/tmp/inspiration-one-storage as a non-persistent request/task workspace.
STORAGE_TEMP_ROOT=
# STORAGE_BACKEND=minio/s3 requires the S3-compatible settings below. S3_PUBLIC_ENDPOINT_URL is optional;
# without it, authenticated attachment downloads fall back to same-origin streaming.
S3_PUBLIC_ENDPOINT_URL=
# Legacy fallback for S3_PUBLIC_ENDPOINT_URL. New deployments should leave this empty.
STORAGE_PUBLIC_BASE_URL=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
STORAGE_SIGNED_URL_TTL_SECONDS=300

# For local-backend production reuse/migration from the
# old systemd release, bind-mount the existing host directory by setting STORAGE_HOST_PATH, for example:
# STORAGE_HOST_PATH=/home/cot/ProductFlow-release/shared/storage
# Leave STORAGE_HOST_PATH unset to use the default Docker named volume inspiration-one-storage.

# Provider settings are configured in the web settings page after startup.
# These legacy TEXT_* / IMAGE_* values are still passed to the containers so the first startup after upgrade can
# create provider_profiles/provider_bindings from existing .env values. After migration, edit providers in /settings.
TEXT_PROVIDER_KIND=mock
TEXT_API_KEY=
TEXT_BASE_URL=
TEXT_BRIEF_MODEL=gpt-4o
TEXT_COPY_MODEL=gpt-4o
IMAGE_PROVIDER_KIND=mock
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_GENERATE_MODEL=gpt-5.4
IMAGE_RESPONSES_BACKGROUND_ENABLED=true
IMAGE_IMAGES_QUALITY=
IMAGE_IMAGES_STYLE=
IMAGE_MAIN_IMAGE_SIZE=1024x1024
IMAGE_PROMO_POSTER_SIZE=1024x1536

# Poster generation: template does not call the image provider; generated does.
POSTER_GENERATION_MODE=template

# Poster rendering
POSTER_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc

# Upload safety
UPLOAD_MAX_IMAGE_BYTES=10485760
UPLOAD_MAX_REFERENCE_IMAGES=6
UPLOAD_MAX_PIXELS=16000000
UPLOAD_ALLOWED_IMAGE_MIME_TYPES=image/png,image/jpeg,image/webp

# Jobs
JOB_MAX_ATTEMPTS=3
JOB_RETRY_DELAY_MS=10000
GENERATION_MAX_CONCURRENT_TASKS=3
TEXT_GENERATION_MAX_CONCURRENT_TASKS=3
IMAGE_GENERATION_MAX_CONCURRENT_TASKS=3
WORKFLOW_IMAGE_GENERATION_PROVIDER_TIMEOUT_SECONDS=900
