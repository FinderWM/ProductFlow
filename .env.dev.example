# ProductFlow development example.
# Copy to .env.dev for dev ports, Redis DB 0, and MinIO object storage. Do not commit .env.dev.
# Use just commands to load this file; do not shell-source production .env for local development.

# Auth (env-only; use local random values)
ADMIN_ACCESS_KEY=replace-with-a-long-random-dev-admin-key
SETTINGS_ACCESS_TOKEN=replace-with-a-separate-dev-settings-token
SESSION_SECRET=replace-with-another-long-random-dev-session-secret

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=29282
WEB_PORT=29283
BACKEND_CORS_ORIGINS=http://localhost:29283,http://127.0.0.1:29283
SESSION_COOKIE_SECURE=false

# Persistence. PostgreSQL and Redis run as shared standalone middleware,
# configured under /Users/yunlong/project/self/env.
POSTGRES_PASSWORD=replace-with-a-random-postgres-password
POSTGRES_HOST_PORT=15432
DATABASE_URL=postgresql+psycopg://productflow:replace-with-a-random-postgres-password@localhost:15432/inspiration_flow
REDIS_HOST_PORT=16379
REDIS_URL=redis://localhost:16379/0
STORAGE_BACKEND=minio
# STORAGE_ROOT belongs only to the local backend. MinIO/S3 uses object storage as its sole persistent file source.
# Set STORAGE_TEMP_ROOT only when a path-only SDK needs an explicit temporary workspace; empty uses the OS temp directory.
STORAGE_TEMP_ROOT=
S3_PUBLIC_ENDPOINT_URL=http://localhost:19000
# Legacy fallback for S3_PUBLIC_ENDPOINT_URL. New development environments should leave this empty.
STORAGE_PUBLIC_BASE_URL=
# Local dev MinIO secrets are loaded from /Users/yunlong/project/self/env/minio.env by scripts/with_dev_env.sh.
# Override these only when using another S3-compatible object storage.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Provider settings are configured in the web settings page after startup.
# These legacy TEXT_* / IMAGE_* values remain dev bootstrap input. First startup can migrate them into
# provider_profiles/provider_bindings; after that, edit providers in /settings.
TEXT_PROVIDER_KIND=mock
TEXT_API_KEY=
TEXT_BASE_URL=
TEXT_BRIEF_MODEL=gpt-4o
TEXT_COPY_MODEL=gpt-4o
IMAGE_PROVIDER_KIND=mock
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_GENERATE_MODEL=gpt-5.4
IMAGE_RESPONSES_BACKGROUND_ENABLED=true
IMAGE_IMAGES_QUALITY=
IMAGE_IMAGES_STYLE=
IMAGE_MAIN_IMAGE_SIZE=1024x1024
IMAGE_PROMO_POSTER_SIZE=1024x1536

# Poster generation
POSTER_GENERATION_MODE=template

# Poster rendering
POSTER_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc

# Upload safety
UPLOAD_MAX_IMAGE_BYTES=10485760
UPLOAD_MAX_REFERENCE_IMAGES=6
UPLOAD_MAX_PIXELS=16000000
UPLOAD_ALLOWED_IMAGE_MIME_TYPES=image/png,image/jpeg,image/webp

# Jobs
JOB_MAX_ATTEMPTS=3
JOB_RETRY_DELAY_MS=10000
GENERATION_MAX_CONCURRENT_TASKS=3
TEXT_GENERATION_MAX_CONCURRENT_TASKS=3
IMAGE_GENERATION_MAX_CONCURRENT_TASKS=3
WORKFLOW_IMAGE_GENERATION_PROVIDER_TIMEOUT_SECONDS=900
